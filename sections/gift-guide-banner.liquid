{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Choose Gift"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}

<section
  class="gift-guide-banner"
  style="background-image: url({{ section.settings.background_image | img_url: '3840x' }});"
>
  <div class="gift-guide-content">
    <h2 class="gift-guide-heading">{{ section.settings.heading }}</h2>
    <p class="gift-guide-subheading">{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.button_link }}" class="gift-guide-btn">
      {{ section.settings.button_label }}
    </a>
  </div>
</section>

<style>
  .gift-guide-banner {
    position: relative;
    background-size: cover;
    background-position: center;
    width: 100%;
    min-height: 1065px; /* Matches given height */
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 20px;
  }

  .gift-guide-content {
    max-width: 1200px;
    margin: auto;
  }

  .gift-guide-heading {
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: 164.78px;
    line-height: 100%;
    color: #000;
    margin-bottom: 40px;
  }

  .gift-guide-subheading {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 47.08px;
    line-height: 140%;
    color: #000;
    margin-bottom: 60px;
  }

  .gift-guide-btn {
    display: inline-block;
    font-family: 'Jost', sans-serif;
    font-size: 24px;
    background: #000;
    color: #fff;
    padding: 16px 40px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.3s ease;
  }

  .gift-guide-btn:hover {
    background: #444;
  }
</style>
