{% comment %}
Custom Banner Section
- Fully editable text & buttons from customizer
- Buttons with hover/active animations
- Responsive & accessible
{% endcomment %}

<section class="c-banner" role="region" aria-label="Hero banner">
  <div class="c-banner__inner">
    {% if section.settings.kicker != blank %}
      <p class="c-banner__kicker">{{ section.settings.kicker }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="c-banner__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="c-banner__sub">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="c-banner__cta">
      {% if section.settings.primary_text != blank %}
        <a href="{{ section.settings.primary_link }}" class="c-btn c-btn--primary" aria-label="{{ section.settings.primary_text }}">
          <span>{{ section.settings.primary_text }}</span>
        </a>
      {% endif %}

      {% if section.settings.secondary_text != blank %}
        <a href="{{ section.settings.secondary_link }}" class="c-btn c-btn--ghost" aria-label="{{ section.settings.secondary_text }}">
          <span>{{ section.settings.secondary_text }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
.c-banner {
  padding: clamp(40px, 8vw, 80px) 16px;
  display: grid;
  place-items: center;
  text-align: center;
  background-color: {{ section.settings.banner_bg | default: "#f9f9f9" }};
}
.c-banner__inner {
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
}
.c-banner__kicker {
  letter-spacing: .12em;
  font-weight: 600;
  text-transform: uppercase;
  margin-bottom: 8px;
  opacity: .8;
}
.c-banner__heading {
  font-size: clamp(28px, 5vw, 60px);
  line-height: 1.1;
  margin: 8px 0 12px;
}
.c-banner__sub {
  font-size: clamp(14px, 2vw, 20px);
  opacity: .9;
  margin: 0 auto 24px;
  max-width: 720px;
}
.c-banner__cta {
  display: inline-flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
}

.c-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 12px 24px;
  font-weight: 600;
  border: 2px solid currentColor;
  text-decoration: none;
  transition: transform .18s ease, box-shadow .25s ease, background .25s ease, color .25s ease;
  will-change: transform;
}
.c-btn:focus {
  outline: none;
  box-shadow: 0 0 0 4px rgba(0,0,0,.2);
}
.c-btn--primary {
  background: {{ section.settings.primary_bg | default: "#111111" }};
  color: {{ section.settings.primary_fg | default: "#ffffff" }};
  border-color: transparent;
}
.c-btn--ghost {
  background: transparent;
  color: {{ section.settings.ghost_fg | default: "#111111" }};
}

.c-btn:hover {
  transform: translateY(-3px) scale(1.03);
  box-shadow: 0 6px 12px rgba(0,0,0,.12);
}
.c-btn:active {
  transform: translateY(0) scale(.98);
  box-shadow: none;
}
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "New Arrival" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome to Our Store" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Discover our latest products and offers" },
    { "type": "text", "id": "primary_text", "label": "Primary Button Text", "default": "Shop Now" },
    { "type": "text", "id": "primary_link", "label": "Primary Button Link", "default": "/collections/all" },
    { "type": "color", "id": "primary_bg", "label": "Primary Button Background", "default": "#111111" },
    { "type": "color", "id": "primary_fg", "label": "Primary Button Text", "default": "#ffffff" },
    { "type": "text", "id": "secondary_text", "label": "Secondary Button Text", "default": "Learn More" },
    { "type": "text", "id": "secondary_link", "label": "Secondary Button Link", "default": "/pages/about-us" },
    { "type": "color", "id": "ghost_fg", "label": "Secondary Button Text Color", "default": "#111111" },
    { "type": "color", "id": "banner_bg", "label": "Banner Background Color", "default": "#f9f9f9" }
  ],
  "presets": [
    { "name": "Custom Banner", "category": "Custom" }
  ]
}
{% endschema %}